# LLM for report text. Default: DeepSeek V4 Flash — OpenAI-compatible, cheap,
# and NOT geoblocked in Russia. Get a key: https://platform.deepseek.com/api_keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_MAX_TOKENS=400
OPENAI_TEMPERATURE=0.7

TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/facebot
REDIS_URL=redis://localhost:6379
# Payment prices: Stars (XTR), card (RUB via provider), crypto (USDT via CryptoBot)
PRICE_STARS=250
MAX_QUEUE_SIZE=100
TEMP_DIR=/tmp/facebot
WEBHOOK_URL=
WEBHOOK_PORT=8080

# Mini App leaderboard. DOMAIN is used by Caddy for auto-TLS; MINIAPP_URL is
# the same host with https:// and is handed to the bot for the Web App button.
DOMAIN=your-domain.com
MINIAPP_URL=https://your-domain.com

# Card payment (Telegram Payments 2.0)
CARD_PROVIDER_TOKEN=
CARD_PRICE_RUB=299

# Crypto (CryptoBot)
CRYPTOBOT_TOKEN=
CRYPTO_PRICE_USDT=3.5

# Channel subscription
CHANNEL_ID=@twitch_s1thxxx

# DANGER: TEST_MODE=true bypasses ALL payments (every analysis becomes free).
# Must be false in production.
TEST_MODE=false

# Free-analysis whitelist: comma-separated @usernames and/or numeric user ids.
# Numeric ids are more reliable (usernames can be changed/re-taken).
# Example: FREE_USERS=@friend1,@friend2,123456789
FREE_USERS=

ML_WEIGHT=0.6
